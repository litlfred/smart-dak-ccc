    {
      "@id": "CodeSystem-FXREQBusinessProcesses.jsonld",
      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/FXREQBusinessProcesses",
      "dcterms:title": "Functional Requirements Business Processes",
      "dcterms:description": "CodeSystem for Functional Requirements Business Processes. Autogenerated from DAK artifacts",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/CodeSystem/FXREQBusinessProcesses"
      }
    },
    {
      "@id": "CodeSystem-FXREQCategories.jsonld",
      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/FXREQCategories",
      "dcterms:title": "Functional Requirement Categories",
      "dcterms:description": "CodeSystem for Functional Requirement Categories. Autogenerated from DAK artifacts",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/CodeSystem/FXREQCategories"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.001.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.001.E",
      "dcterms:title": "Identify and discuss follow-up location options",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Identify and discuss follow-up location options:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Provide a list of follow-up location options and contact details\n\nso that\n\n>I can choose the best options for the client and schedule a follow-up",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.001.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.001.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.001.F",
      "dcterms:title": "Aggregate reporting and data use",
      "dcterms:description": "*Business process* (F) Aggregate Reporting:\nActivity: Aggregate reporting and data use:\nAs a <a href=\"ActorDefinition-facilitystafffacilitystaffinchargedistricthealthofficerstaff.html\">Facility staff, facility staff in charge, district health officer/staff</a>, I want to:\n>Produce a range of prepared and ad hoc reports and analyses \n\nso that\n\n>I am able to use data collected at the facility, including data for service delivery (beyond reporting purposes alone)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.001.F"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.001.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.001.G",
      "dcterms:title": "General solution requirements – Data dictionary",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Data dictionary:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Solution must be able to leverage the data dictionary (to be produced as part of workstream 2/3 work) \n\nso that\n\n>The tool is consistent",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.001.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.002.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.002.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Allow the recording of key observations during a visit and a space to make general notes about the consultation and treatment provided\n\nso that\n\n>I can ensure that the client's health information is recorded and kept up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.002.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.002.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.002.D",
      "dcterms:title": "Prepare for emergency referral",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Prepare for emergency referral:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a list of emergency referral locations and contact details if local emergency number (e.g. 911/999) is not used\n\nso that\n\n>I can arrange emergency services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.002.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.002.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.002.E",
      "dcterms:title": "Arrange appointment for follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Arrange appointment for follow-up:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Display a schedule of available days\n\nso that\n\n>I can notify client when to return for subsequent contact",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.002.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.002.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.002.F",
      "dcterms:title": "Aggregate reporting and data use",
      "dcterms:description": "*Business process* (F) Aggregate Reporting:\nActivity: Aggregate reporting and data use:\nAs a <a href=\"ActorDefinition-facilitystafffacilitystaffinchargedistricthealthofficerstaff.html\">Facility staff, facility staff in charge, district health officer/staff</a>, I want to:\n>Be able to view data on my own performance and service delivery  \n\nso that\n\n>I can understand trends and challenges and track my own performance over time ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.002.F"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.002.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.002.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Provide a modular approach to the solution to accommodate variations required to make the solution country-specific, for example: \n- ability to use/not to use personal identifiers for registration \n- include a focus on symptoms/diagnosis that may appear in a country-susceptible manner (malaria, HIV)\n- treatment modules that may be available in the country/setting (e.g. oral only vs injections)\n\nso that\n\n>The registration and consultation process includes what is more likely required without by-passing questions that are not required ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.002.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.003.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.003.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide decision support as appropriate for users based on the data entered\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.003.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.003.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.003.D",
      "dcterms:title": "Identify and discuss referral location options",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Identify and discuss referral location options:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide a list of referral location options, specialisms and contact details\n\nso that\n\n>I can choose the best options for the client's contact facility and schedule a referral",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.003.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.003.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.003.E",
      "dcterms:title": "Arrange appointment for follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Arrange appointment for follow-up:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Indicate (based on protocol) the preferred days for follow-up contact\n\nso that\n\n>The client receives services according to the recommended contact schedule",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.003.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.003.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.003.F",
      "dcterms:title": "Aggregate reporting and data use",
      "dcterms:description": "*Business process* (F) Aggregate Reporting:\nActivity: Aggregate reporting and data use:\nAs a <a href=\"ActorDefinition-facilitystafffacilitystaffinchargedistricthealthofficerstaff.html\">Facility staff, facility staff in charge, district health officer/staff</a>, I want to:\n>Be able to run calculations on data to populate indicators or reports on my own performance and service delivery – calculations on data should be conducted with Fast Health Interoperability Resources (FHIR) and contextual query language\n\nso that\n\n>I can understand trends and challenges and track my own performance over time ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.003.F"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.003.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.003.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Manage clinical algorithm guidance changes through a change management process with quality assurance (using a reference system) and be able to push the information out to all solutions in use \n\nso that\n\n>I can ensure that all guidance being followed in the field is using the latest approved guidance from WHO",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.003.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.004.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.004.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to choose the option to refer in general to the SMART guidance without having to complete a full consultation (e.g. for training/reference only) \n\nso that\n\n>I can refresh my training and knowledge",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.004.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.004.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.004.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Suggest appropriate treatments/investigations based on findings including the ability to propose alternative treatments in the case that the primary treatment is not available\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.004.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.004.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.004.D",
      "dcterms:title": "Identify and discuss referral location options",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Identify and discuss referral location options:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Be able to find out where a treatment method may be available nearby \n\nso that\n\n>I can refer my client to another facility to receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.004.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.004.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.004.E",
      "dcterms:title": "Arrange appointment for follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Arrange appointment for follow-up:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Record identification and tracking information (such as mobile phone number) \n\nso that\n\n>I can follow up and remind the client on when to return for services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.004.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.004.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.004.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Be able to track treatments via reference numbers so that these can be updated as required and can be used to create \\\"treatment modules\\\" pertinent to a country or emergency setting\n\nso that\n\n>Countries can implement the correct treatment module for their regulations and emergency setting",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.004.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.A",
      "dcterms:title": "Triage and emergency assessment",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Triage and emergency assessment:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Bypass the standard flow at any point if an urgent case is identified – Refer to Business Process G. Triage and assessment\n\nso that\n\n>The child/infant can receive immediate attention – Refer to Business Process G. Triage and assessment",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to choose the option of a consultation that leads me through the full process to assess and classify the sick child and further to treat the child, referral and follow-up\n\nso that\n\n>I can ensure that a complete consultation is provided",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Be able to show improvements or decline of a client's health based on previous/current consultations including before and after treatment\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.D",
      "dcterms:title": "Identify and discuss referral location options",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Identify and discuss referral location options:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Find facilities that can provide the service or treatment method that mine cannot provide. \n\nso that\n\n>The client does not travel to a facility that cannot help them",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.E",
      "dcterms:title": "Arrange appointment for follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Arrange appointment for follow-up:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Display the number of existing contacts per day (to allow for balancing)\n\nso that\n\n>I can manage and follow up on clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.005.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.005.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Be able to differentiate between simple and complex care provision requirements\n\nso that\n\n>I can provide the correct level of detail for the user type (e.g. doctor/specialist vs nurse health workers)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.005.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.006.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.006.A",
      "dcterms:title": "Gather neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Gather neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to gather the client's caregiver basic information (if required)\n\nso that\n\n>I can track and follow the name of the client's caregiver for the purposes of engagement during the consultation",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.006.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.006.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.006.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to route the consultation via different health workers and save the information already entered to the consultation, even if the consultation is not yet complete, enabling other health workers to see the information already entered and to be able to add/edit information as it becomes available. \n\nso that\n\n>I do not have to start a new consultation for every health worker that the client is involved with",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.006.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.006.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.006.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide context-sensitive, real-time decision support in response to the entry of clinical data (alerts, advice, resources)\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.006.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.006.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.006.E",
      "dcterms:title": "Arrange appointment for follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Arrange appointment for follow-up:\nAs a <a href=\"ActorDefinition-automatedsystemnotification.html\">Automated system notification</a>, I want to:\n>Notify/send a reminder to the client's caregiver for the referral appointment \n\nso that\n\n>So that the caregiver does not forget the appointment to receive the required health services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.006.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.006.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.006.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Be able to build the type of solution suitable for my country/setting using the correct modules according to preferences\n\nso that\n\n>I can build the solution as closely as possible to the country/setting according to regulations within the country and according to our specific solution requirements",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.006.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.007.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.007.A",
      "dcterms:title": "Gather neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Gather neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to gather unique identifier number/information pertaining to the client that does not include personal information \n\nso that\n\n>I do not have to manage personal information management regulations/laws",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.007.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.007.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.007.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Identify key symptoms and signs that may require medical attention\n\nso that\n\n>I can provide the appropriate services as quickly as possible",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.007.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.007.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.007.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide decision support as appropriate for users \n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.007.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.007.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.007.D",
      "dcterms:title": "Facility accommodates referral",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Facility accommodates referral:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Be able to share my client’s health records with the referral facility \n\nso that\n\n>They can provide the health care my client needs",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.007.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.007.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.007.G",
      "dcterms:title": "General solution requirements – User feedback",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – User feedback:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>Be able to provide feedback to the facility administrator/IT administrator for issues users notice through daily use of the tool and recommended solution improvements.\n\nso that\n\n>Future solution development can be improved for the users",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.007.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.008.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.008.A",
      "dcterms:title": "Gather neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Gather neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to gather unique identifier number/information pertaining to the client that includes personal information \n\nso that\n\n>I can identify the client using personal information within personal information management regulations/laws",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.008.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.008.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.008.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Determine whether to manage client at the facility or refer\n\nso that\n\n>I can ensure the client receives appropriate services as quickly as possible",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.008.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.008.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.008.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide a source to access accurate health information \n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.008.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.008.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.008.D",
      "dcterms:title": "Facility accommodates referral",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Facility accommodates referral:\nAs a <a href=\"ActorDefinition-automatedsystemnotification.html\">Automated system notification</a>, I want to:\n>Notify/send a reminder to the client's caregiver for the referral appointment \n\nso that\n\n>So that the caregiver does not forget the appointment to receive the required health services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.008.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.008.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.008.G",
      "dcterms:title": "General solution requirements – Media",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Media:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>The solution to support multi-media, such as video, photos and audio\n\nso that\n\n>Examples of symptoms, diagnosis and treatment may be used throughout the consultation process",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.008.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.009.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.009.A",
      "dcterms:title": "Search for neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Search for neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Search if the client is already in system (using at least two identifiers) (including information pertaining to the client's caregiver)\n\nso that\n\n>I can check if this is a new or existing client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.009.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.009.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.009.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>View a review of any past medical history previously entered\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.009.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.009.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.009.C",
      "dcterms:title": "Counselling, in-facility management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Receive information messages in a way that ensures patient confidentiality\n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.009.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.009.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.009.D",
      "dcterms:title": "Referral facility registration",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Referral facility registration:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a list or roster of all infant/child clients\n\nso that\n\n>I know which clients to follow up or are due for services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.009.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.009.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.009.G",
      "dcterms:title": "General solution requirements – Sync",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Sync:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>The solution to store data in an FHIR-compliant server\n\nso that\n\n>Consistency of data representation and ability to exchange data with other services and solutions using FHIR standards and common value sets (International Statistical Classification of Diseases and Related Health Problems, Logical Observation Identifiers, Names and Codes)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.009.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.010.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.010.A",
      "dcterms:title": "Search for neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Search for neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Display sufficient data to identify the client\n\nso that\n\n>I can confirm that it is the correct client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.010.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.010.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.010.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Create a new referral request to the health facility\n\nso that\n\n>I can refer my client so that they receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.010.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.010.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.010.D",
      "dcterms:title": "Referral facility registration",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Referral facility registration:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide tools to search, sort and filter the infant/child database\n\nso that\n\n>I can manage and follow up on clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.010.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.010.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.010.E",
      "dcterms:title": "Contact follow-up facility",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Contact follow-up facility:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Display a schedule of available days\n\nso that\n\n>I can notify the client when to return for subsequent contact",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.010.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.010.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.010.G",
      "dcterms:title": "General solution requirements – Sync",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Sync:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>The solution to sync data in an FHIR-compliant server\n\nso that\n\n>Ensure that data are stored and synced with a server, so that patient information relevant to another user of Child Health in Emergencies Digital Platform can access information for client history and to maintain continuity in care delivery ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.010.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.A",
      "dcterms:title": "Search for neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Search for neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Require a user to search if a client is already in the system before starting a new medical record entry\n\nso that\n\n>I can confirm that it is the correct client and update information as necessary",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.B",
      "dcterms:title": "Determine if this is an initial visit or a follow-up visit",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Determine if this is an initial visit or a follow-up visit:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Indicate that the patient has arrived for the initial visit, scheduled contact or specific complaint (tasks will vary based on health worker roles)\n\nso that\n\n>I can know what services to provide",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Create a new follow-up request to the health facility\n\nso that\n\n>I can refer my client so that they receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.D",
      "dcterms:title": "Discuss questions with infant/child's caregiver",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Discuss questions with infant/child's caregiver:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide/print/share information/clinical guidance to the client's caregiver as relevant \n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.E",
      "dcterms:title": "Contact follow-up facility",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Contact follow-up facility:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Indicate (based on the protocol) the preferred days for follow-up contact\n\nso that\n\n>The client receives services according to recommended contact schedule",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.011.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.011.G",
      "dcterms:title": "General solution requirements – Sync",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Sync:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>The solution to represent data in an FHIR format that can be synced with client applications that use the FHIR international patient summary (IPS) on their mobile devices\n\nso that\n\n>To ensure that clients are able to access their personal records and keep a copy on their phones using the Health Level 7 IPS format.",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.011.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.A",
      "dcterms:title": "Search for neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Search for neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Read client identification system (e.g. quick response [QR] code, barcode, fingerprint) and pull up client information\n\nso that\n\n>I can confirm that it is the correct client and update information as necessary",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.B",
      "dcterms:title": "Determine the age of the neonate/infant/child ",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Determine the age of the neonate/infant/child :\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Be able to view the age of the client on the client record or after consultation with the caregiver to add the client's age to the record\n\nso that\n\n>I can provide appropriate services for the client's problems based on their age",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide decision support as appropriate for users based on the data entered\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.D",
      "dcterms:title": "Discuss questions with infant/child's caregiver",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Discuss questions with infant/child's caregiver:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide a way to share sources to access to accurate health information \n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.E",
      "dcterms:title": "Contact follow-up facility",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Contact follow-up facility:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Record identification and tracking information (such as mobile phone number) \n\nso that\n\n>I can follow up and remind the client on when to return for services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.012.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.012.G",
      "dcterms:title": "General solution requirements – Modular approach",
      "dcterms:description": "*Business process* (G) Triage and Emergency Assessment:\nActivity: General solution requirements – Modular approach:\nAs a <a href=\"ActorDefinition-allusers.html\">All Users</a>, I want to:\n>To be able to add data and calculations as well as forms to the reference application, for localization (language support) and adaptation (addition of core health and data content), as well as calculations for decision-support and populating indicators\n\nso that\n\n>The tool and embedded forms (and associated interventions) can be adapted and localized by the user's governments/WHO/partners without requiring the assistance of engineers from the vendor each time",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.012.G"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.013.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.013.A",
      "dcterms:title": "Search for neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Search for neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Provide sufficient data to rule out that this client is already in the system\n\nso that\n\n>I can avoid duplicates ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.013.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.013.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.013.B",
      "dcterms:title": "Determine the age of the neonate/infant/child",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Determine the age of the neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Indicate if the age of the child is not known and be able to provide information as to how an age determination has been agreed\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.013.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.013.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.013.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Suggest appropriate treatments/investigations based on findings\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.013.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.013.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.013.D",
      "dcterms:title": "Discuss questions with infant/child's caregiver",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Discuss questions with infant/child's caregiver:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide a way for the client's caregiver to receive information messages in a way that ensures patient confidentiality\n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.013.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.014.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.014.A",
      "dcterms:title": "Review socio-demographic data with infant/child carer",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Review socio-demographic data with infant/child carer:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Add data that provide socio-demographic information about the client\n\nso that\n\n>I can use the data to for analysis, forecasting and planning",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.014.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.014.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.014.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a standardized form for the entry of the clients profile\n\nso that\n\n>I can ensure the client's health information is recorded and up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.014.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.014.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.014.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide context-sensitive, real-time decision support in response to the entry of clinical data (alerts, advice, resources)\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.014.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.014.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.014.E",
      "dcterms:title": "Provide information follow-up",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Provide information follow-up:\nAs a <a href=\"ActorDefinition-facilityhealthworker.html\">Facility health worker</a>, I want to:\n>Be able to share my client’s health records with the follow-up facility \n\nso that\n\n>They can provide the care my client needs",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.014.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.015.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.015.A",
      "dcterms:title": "Review socio-demographic data with infant/child carer",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Review socio-demographic data with infant/child carer:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Edit data that provide socio-demographic information about the client\n\nso that\n\n>I can use the data to for analysis, forecasting and planning",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.015.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.015.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.015.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a standardized form for the entry of clinical data\n\nso that\n\n>I can ensure the client's health information is recorded and up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.015.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.015.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.015.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide decision support as appropriate for users based on the data entered\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.015.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.015.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.015.D",
      "dcterms:title": "Receive neonate/infant/child",
      "dcterms:description": "*Business process* (D) Referral:\nActivity: Receive neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Be able to know the care my client received at the referral facility \n\nso that\n\n>I can provide appropriate care if my client comes back to my facility",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.015.D"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.015.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.015.E",
      "dcterms:title": "Plan for routine, targeted community support",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Plan for routine, targeted community support:\nAs a <a href=\"ActorDefinition-communityhealthworker.html\">Community health worker</a>, I want to:\n>Provide a list or roster of all clients in the schedule\n\nso that\n\n>I can manage and follow up on clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.015.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.016.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.016.A",
      "dcterms:title": "Update neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Update neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to edit the identification information (including information pertaining to the client's caregiver)\n\nso that\n\n>I can update existing client information ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.016.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.016.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.016.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide real-time range checks and data integrity checks on data\n\nso that\n\n>I can ensure the entry of accurate information and reduce errors",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.016.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.016.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.016.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Provide a source to access accurate health information \n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.016.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.016.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.016.E",
      "dcterms:title": "Plan for routine, targeted community support",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Plan for routine, targeted community support:\nAs a <a href=\"ActorDefinition-communityhealthworker.html\">Community health worker</a>, I want to:\n>Provide a list of scheduled contacts and to allow for defaulters to be traced\n\nso that\n\n>I can track and follow up clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.016.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.017.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.017.A",
      "dcterms:title": "Update neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Update neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Indicate mandatory fields that must be filled out for the registration to be valid\n\nso that\n\n>I can ensure all necessary information has been completed",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.017.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.017.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.017.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to follow a consultation that focuses initially on the symptoms highlighted by the caregiver but that continues a full assessment of all possible symptoms \n\nso that\n\n>I can provide a complete consultation and identify if there is more than one diagnosis and treatment recommendation",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.017.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.017.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.017.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworkerandneonateinfantchildcaregiver.html\">Health worker and neonate/infant/child (caregiver)</a>, I want to:\n>Receive information messages/alerts in a way that ensures patient confidentiality\n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.017.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.017.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.017.E",
      "dcterms:title": "Attend follow-up at home, in the community or at the health facility ",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Attend follow-up at home, in the community or at the health facility :\nAs a <a href=\"ActorDefinition-neonateinfantchildcaregiver.html\">Neonate/infant/child (caregiver)</a>, I want to:\n>Refer to Business Process A: Registration\n\nso that\n\n>I can register attendance of the follow-up",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.017.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.018.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.018.A",
      "dcterms:title": "Update neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Update neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Allow edits to fields on screen before information is committed\n\nso that\n\n>I can ensure information has been checked before submission",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.018.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.018.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.018.B",
      "dcterms:title": "Ask the caregiver what the neonate/infant/child's problems are",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Ask the caregiver what the neonate/infant/child's problems are:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to route the consultation via different health workers and save the information already entered to the consultation, even if the consultation is not yet complete, enabling other health workers to see the information already entered and to be able to add/edit information as it becomes available\n\nso that\n\n>I do not have to start a new consultation for every health worker that the client is involved with",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.018.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.018.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.018.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Allow the recording of key observations during the follow-up visit\n\nso that\n\n>I can ensure the client's health information is recorded and kept up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.018.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.018.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.018.E",
      "dcterms:title": "Visit sick neonate/infant/child",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Visit sick neonate/infant/child:\nAs a <a href=\"ActorDefinition-communityhealthworker.html\">Community health worker</a>, I want to:\n>Refer to Business Process A: Registration\n\nso that\n\n>I can identify the correct client details and health records",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.018.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.019.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.019.A",
      "dcterms:title": "Update neonate/infant/child details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Update neonate/infant/child details:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Allow for a temporary identification in emergency situations when full identity is unknown\n\nso that\n\n>I can proceed with registration ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.019.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.019.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.019.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Highlight abnormal values\n\nso that\n\n>I can identify critical health issues or errors (if a data entry issue)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.019.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.019.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.019.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Create a new referral request to the health facility\n\nso that\n\n>I can refer my client so that they receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.019.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.020.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.020.A",
      "dcterms:title": "Create neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Create neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to enter new identification information (including information pertaining to the client's caregiver)\n\nso that\n\n>I can enter new client information ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.020.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.020.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.020.B",
      "dcterms:title": "Perform tests (laboratory)",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Perform tests (laboratory):\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a list of tests that the health worker can order for the client based on guidance for their age/symptoms/diagnosis\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.020.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.020.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.020.C",
      "dcterms:title": "Counselling, in-facility or community management and treatment",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Counselling, in-facility or community management and treatment:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Create a new follow-up request to the health facility\n\nso that\n\n>I can refer my client so that they receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.020.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.021.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.021.A",
      "dcterms:title": "Create neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Create neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Indicate mandatory fields that must be filled out for the registration to be valid\n\nso that\n\n>I can ensure all necessary information has been completed",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.021.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.021.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.021.B",
      "dcterms:title": "Perform tests (laboratory)",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Perform tests (laboratory):\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide information so that test results that have been ordered can be recorded\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.021.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.021.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.021.C",
      "dcterms:title": "Check if the neonate/infant/child has any new problems",
      "dcterms:description": "*Business process* (C) Treat the child:\nActivity: Check if the neonate/infant/child has any new problems:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Be able to start a new Business Process B: Assess and classify the sick child if new symptoms have been identified with the client\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.021.C"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.021.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.021.E",
      "dcterms:title": "Self/caregiver care in the home or community",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Self/caregiver care in the home or community:\nAs a <a href=\"ActorDefinition-neonateinfantchildcaregiver.html\">Neonate/infant/child (caregiver)</a>, I want to:\n>Provide/print/share information/clinical guidance with the client's caregiver as relevant \n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.021.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.022.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.022.A",
      "dcterms:title": "Create neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Create neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Allow edits to fields on screen before information is committed\n\nso that\n\n>I can ensure information has been checked before submission",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.022.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.022.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.022.B",
      "dcterms:title": "Diagnosis",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Diagnosis:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to agree/disagree with the diagnosis presented from the guidance and be able to select an alternative diagnosis stating the reasoning regarding the decision\n\nso that\n\n>If a diagnosis is deemed incorrect that I can correct it with suitable reasoning to ensure that the correct treatment recommendations are provided",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.022.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.022.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.022.E",
      "dcterms:title": "Self/caregiver care in the home or community",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Self/caregiver care in the home or community:\nAs a <a href=\"ActorDefinition-neonateinfantchildcaregiver.html\">Neonate/infant/child (caregiver)</a>, I want to:\n>Provide a way to share sources for access accurate health information \n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.022.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.023.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.023.A",
      "dcterms:title": "Create neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Create neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Allow for a temporary identification in emergency situations when full identity is unknown\n\nso that\n\n>I can proceed with registration ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.023.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.023.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.023.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a standardized form for the entry of the client's profile\n\nso that\n\n>I can ensure the client's health information is recorded and up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.023.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.023.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.023.E",
      "dcterms:title": "Self/caregiver care in the home or community",
      "dcterms:description": "*Business process* (E) Follow-up:\nActivity: Self/caregiver care in the home or community:\nAs a <a href=\"ActorDefinition-neonateinfantchildcaregiver.html\">Neonate/infant/child (caregiver)</a>, I want to:\n>Provide a way for the client's caregiver to receive information messages in a way that ensures patient confidentiality\n\nso that\n\n>I can manage my client's health in my daily life",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.023.E"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.024.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.024.A",
      "dcterms:title": "Create neonate/infant/child record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Create neonate/infant/child record:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Be able to input biometric information only (e.g. age, sex, respiration, weight, birthweight, height)\n\nso that\n\n>I can proceed without using personal information but still maintain medical information via a unique identifier number (also useful in emergency scenarios)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.024.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.024.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.024.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a standardized form for the entry of clinical data\n\nso that\n\n>I can ensure the client's health information is recorded and up to date",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.024.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.025.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.025.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Record a time/date-stamped new contact (encounter)\n\nso that\n\n>I can confirm when the client came",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.025.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.025.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.025.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide real-time range checks and data integrity checks on data\n\nso that\n\n>I can ensure the entry of accurate information and reduce errors",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.025.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.026.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.026.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Identify in the client's record if this is a follow-up appointment or an initial visit\n\nso that\n\n>I can identify which process to follow and view the client's previous problems that required a follow-up",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.026.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.026.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.026.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to follow a consultation that focuses initially on the symptoms highlighted by the caregiver but that continues a full assessment of all possible symptoms \n\nso that\n\n>I can provide a complete consultation and identify if there is more than one diagnosis and treatment recommendation",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.026.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.027.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.027.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Provide the ability to \\\"check in\\\" for a scheduled contact\n\nso that\n\n>I can initiate services at the follow-up contact",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.027.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.027.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.027.B",
      "dcterms:title": "Check symptoms and conduct physical exam",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Check symptoms and conduct physical exam:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Highlight abnormal values\n\nso that\n\n>I can identify critical health issues or errors (if a data entry issue)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.027.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.028.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.028.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Identify the date of the last attended contact\n\nso that\n\n>I can ensure client is receiving services according to the recommended contact schedule",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.028.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.028.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.028.B",
      "dcterms:title": "Perform tests (laboratory)",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Perform tests (laboratory):\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide a list of tests that the health worker can order\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.028.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.029.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.029.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Provide a list of scheduled contacts to allow for defaulters to be traced\n\nso that\n\n>I can track and follow up clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.029.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.029.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.029.B",
      "dcterms:title": "Perform tests (laboratory)",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Perform tests (laboratory):\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>Provide fields where test results that have been ordered can be recorded\n\nso that\n\n>I can provide appropriate services according to the latest clinical protocols",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.029.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.030.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.030.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Provide a list or roster of all infant/child clients due to arrive\n\nso that\n\n>I know which clients to follow up or are due for services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.030.A"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.030.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.030.B",
      "dcterms:title": "Diagnosis",
      "dcterms:description": "*Business process* (B) Assess and Classify the Sick Child:\nActivity: Diagnosis:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to agree/disagree with the diagnosis presented from the guidance and be able to select an alternative diagnosis stating the reasoning regarding the decision\n\nso that\n\n>If a diagnosis is deemed incorrect that I can correct it with suitable reasoning to ensure that the correct treatment recommendations are provided",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.030.B"
      }
    },
    {
      "@id": "Requirements-CHE.FXREQ.031.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/CHE.FXREQ.031.A",
      "dcterms:title": "Check in neonate/infant/child",
      "dcterms:description": "*Business process* (A) Registration:\nActivity: Check in neonate/infant/child:\nAs a <a href=\"ActorDefinition-healthworkerorclerk.html\">Health worker or clerk</a>, I want to:\n>Provide tools to search, sort and filter the infant/child client database\n\nso that\n\n>I can manage and follow up on clients requiring services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-ccc/Requirements/CHE.FXREQ.031.A"
      }
    },
